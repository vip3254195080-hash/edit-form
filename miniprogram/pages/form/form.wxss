.container {
  padding: 30rpx;
  min-height: 100vh;
}
.header {
  margin-bottom: 24rpx;
}
.title {
  font-size: 38rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
}
.desc {
  font-size: 24rpx;
  color: #888888;
  margin-top: 8rpx;
  display: block;
}
.form-card {
  background: #ffffff;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.form-item {
  margin-bottom: 26rpx;
}
.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}
.required {
  color: #e54d42;
}
.input, .picker-box {
  background-color: #f8f9fa;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
}
.textarea {
  background-color: #f8f9fa;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  font-size: 28rpx;
  height: 160rpx;
}
.submit-btn {
  background-color: #07C160;
  color: #ffffff;
  font-weight: 600;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
}